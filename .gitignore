# Verification screenshots, regenerated by scripts/shoot-*.mjs and verify-*.mjs.
#
# One frame per sprint of the Explore run is kept, under docs/evidence/. The
# kill criteria in docs/EXPLORE-MODE-PLAN.md are visual, so the closing report
# has to point at the frames it was judged on rather than at a rebuild that
# might not reproduce them. The rest of shots/ is disposable.
shots/

# Generated from NYC Open Data by scripts/fetch-lod2-massing.ts — 20 seconds to rebuild.
/public/lod2/

# The development dataset, rebuilt by scripts/make-dev-fixture.ts in one command.
#
# With --live it holds a read-only snapshot of the real market: real landlord
# availability, real asking rents. A snapshot of a live market does not belong
# in a git history, where it will still be sitting there a year from now,
# silently stale and indistinguishable from current. Same rule as the massing.
/fixtures/

# The streamed city. Regenerated by scripts/build-3dtiles.ts, exactly as
# public/lod2/massing.json is — a directory of binary tiles does not belong in
# a git history.
/public/3dtiles/
